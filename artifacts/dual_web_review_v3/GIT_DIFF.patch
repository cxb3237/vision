+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
+  <title>钢球平板调试台</title>
+  <link rel="stylesheet" href="/style.css?v=6">
+</head>
+<body>
+  <div id="appShell">
+    <section id="previewPane" class="preview-pane" aria-label="实时摄像头预览">
+      <img id="preview" alt="实时标注画面">
+      <div class="preview-overlay">摄像头 <b id="cameraFps">0.0</b> / 识别 <b id="fps">0.0</b> / 预览 <b id="previewFps">0.0</b></div>
+      <div id="debugStreamNotice" class="debug-stream-notice">
+        <strong id="debugStreamNoticeTitle">调试视频流正在连接</strong>
+        <span id="debugStreamNoticeDetail">正在自动建立实时画面。</span>
+      </div>
+    </section>
+
