+    setDiagnostic(
+      `设置值：${formatControlValue(name, desired, info)}　实际值：${formatControlValue(name, info.actual, info)}`,
+    );
+  } else {
+    setDiagnostic("");
+    row.classList.remove("pending");
+  }
