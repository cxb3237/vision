+.modal-backdrop[hidden] { display: none; }
+.maintenance-menu, .confirm-dialog { width: min(100%, 380px); padding: 16px; display: grid; gap: 8px; border: 1px solid var(--line); border-radius: 15px; background: #101b22; box-shadow: 0 20px 60px #0009; }
+.maintenance-menu p, .confirm-dialog p { margin: 0 0 4px; color: var(--muted); }
+.confirm-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.stopped-overlay { position: fixed; z-index: 50; inset: 0; display: grid; place-items: center; background: #05090cf2; color: var(--accent); font-size: clamp(30px, 8vw, 72px); font-weight: 900; }
+.stopped-overlay[hidden] { display: none; }
+#toast { position: fixed; z-index: 60; left: 50%; bottom: 12px; transform: translateX(-50%); max-width: 90vw; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; background: #05090cf2; opacity: 0; pointer-events: none; transition: opacity 180ms; }
+#toast.show { opacity: 1; }
+
+@media (max-height: 560px) and (orientation: landscape) {
+  .side-dock { grid-template-rows: 58px auto minmax(0, 1fr) 58px; }
+  .dock-header { height: 58px; min-height: 58px; }
+  .always-status { padding-block: 3px; }
+  .dock-content { padding: 4px 8px 4px 12px; }
+  .status-tags { gap: 3px; margin-bottom: 3px; }
+  .status-tag { min-height: 21px; padding-block: 2px; }
+  .ball-position-card { margin-bottom: 3px; padding-block: 2px; }
+  .ball-position-card strong { font-size: 25px; }
+  .telemetry-lines div { padding: 3px 7px; }
+  .error-line { margin-top: 4px; min-height: 26px; max-height: 30px; padding-block: 4px; }
+  .dock-section { margin-top: 4px; }
+  .dock-section h2 { margin-bottom: 4px; }
+  button { min-height: 48px; }
+}
+
+@media (orientation: portrait), (max-width: 700px) {
+  #appShell { grid-template-columns: 1fr; grid-template-rows: minmax(0, 56dvh) minmax(0, 44dvh); }
+  .side-dock { border-left: 0; border-top: 1px solid var(--line); }
+  .camera-drawer { transform: translateX(100%); }
+  .dock-content { overflow-y: auto; overscroll-behavior: contain; }
+  .dock-header { min-height: 58px; }
+}
+
+@media (min-width: 1000px) and (min-height: 600px) {
+  :root { --dock-width: clamp(400px, 40vw, 620px); }
+  .telemetry-lines { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .mcu-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
+}
