+        <button id="drawerHandle" class="icon-button drawer-handle" aria-label="打开摄像头参数" aria-expanded="false"><span>‹</span></button>
+        <button id="maintenanceButton" class="icon-button maintenance-button" aria-label="长按打开维护菜单"><span>⋮</span><i id="maintenanceProgress"></i></button>
+      </header>
+
+      <section class="always-status" aria-label="关键状态">
+        <div class="status-tags">
+          <span id="runningBadge" class="status-tag offline">服务已停止</span>
+          <span id="cameraBadge" class="status-tag offline">摄像头离线</span>
+          <span id="serialBadge" class="status-tag offline">串口离线</span>
+          <span id="mcuBadge" class="status-tag warning">MCU 未就绪</span>
+        </div>
+        <section class="ball-position-card" aria-label="钢球横向位置">
+          <span>钢球毫米位置</span><strong id="ballPosition">-- mm</strong>
+          <small id="ballDetected">未识别</small>
+        </section>
+        <dl class="key-grid">
+          <div><dt>S 控制状态</dt><dd id="keyS">--</dd></div>
+          <div><dt>F 故障码</dt><dd id="keyF">--</dd></div>
