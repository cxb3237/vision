@@ -0,0 +1,91 @@
+:root {
+  color-scheme: dark;
+  font-family: system-ui, "Microsoft YaHei", sans-serif;
+  background: #071018;
+  color: #eef7ff;
+}
+
+* { box-sizing: border-box; }
+html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
+button { min-height: 52px; border: 1px solid #45647c; border-radius: 12px; padding: 0 20px; color: inherit; background: #193047; font: inherit; font-weight: 700; touch-action: manipulation; }
+button:disabled { opacity: .42; }
+button:active { transform: translateY(1px); }
+
+.competition-shell {
+  height: 100dvh;
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto auto;
+  gap: 8px;
+  padding: max(8px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));
+  background: radial-gradient(circle at 50% 0, #17314a 0, #071018 48%);
+}
+
+.status-bar {
+  min-height: 56px;
+  display: grid;
+  grid-template-columns: minmax(180px, 1.5fr) repeat(5, minmax(88px, 1fr));
+  gap: 8px;
+}
+
+.brand, .status-item, .recording-detail {
+  border: 1px solid #28465e;
+  border-radius: 12px;
+  background: rgba(14, 31, 45, .94);
+}
+
+.brand, .status-item { display: flex; justify-content: center; flex-direction: column; padding: 7px 12px; }
+.brand strong { font-size: 20px; }
+.brand span, .status-item span { color: #94aec2; font-size: 12px; }
+.status-item strong { color: #72d7a2; white-space: nowrap; }
+
+.preview-card { position: relative; min-height: 0; overflow: hidden; border: 1px solid #2d536f; border-radius: 14px; background: #020508; }
+.preview-card img { width: 100%; height: 100%; display: block; object-fit: contain; }
+.offline-notice { position: absolute; inset: 0; display: grid; place-content: center; gap: 6px; text-align: center; background: rgba(5, 12, 18, .88); }
+.offline-notice[hidden] { display: none; }
+.offline-notice strong { font-size: 24px; color: #ff9b8f; }
+.offline-notice span { color: #bfd0dc; }
+.recording-overlay { position: absolute; top: 12px; left: 12px; padding: 6px 10px; border-radius: 8px; background: rgba(112, 8, 8, .82); font-weight: 800; }
+.recording-overlay i { display: inline-block; width: 10px; height: 10px; margin-right: 5px; border-radius: 50%; background: #ff4e4e; animation: pulse 1s infinite; }
+.file-overlay { position: absolute; right: 10px; bottom: 8px; max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 4px 8px; border-radius: 6px; background: rgba(0, 0, 0, .58); font-size: 13px; }
+@keyframes pulse { 50% { opacity: .35; } }
+
+.recording-detail { min-height: 38px; display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 10px; align-items: center; padding: 4px 12px; color: #a9becc; font-size: 13px; }
+.recording-detail span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.recording-detail strong { color: #f4f9fc; }
+
+.action-bar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
+.action-bar .primary { background: #12613d; border-color: #36a875; }
+.action-bar .danger { background: #812d31; border-color: #d4585f; }
+
+.recordings-panel { position: absolute; inset: 70px 18px 74px; z-index: 5; display: grid; grid-template-columns: minmax(300px, .9fr) minmax(420px, 1.4fr); grid-template-rows: auto minmax(0, 1fr); gap: 10px; padding: 14px; border: 1px solid #4d7087; border-radius: 16px; background: rgba(7, 17, 25, .98); box-shadow: 0 18px 50px #000b; }
+.recordings-panel[hidden] { display: none; }
+.panel-head { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; }
+.panel-head h2 { margin: 0; }
+.panel-head button { min-height: 48px; }
+.recordings-list { min-height: 0; overflow-y: auto; display: grid; align-content: start; gap: 8px; }
+.recording-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center; padding: 8px 10px; border-radius: 10px; background: #12283a; }
+.recording-row .meta { min-width: 0; }
+.recording-row strong, .recording-row small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.recording-row small { color: #9bb1c0; }
+.codec-warning { grid-column: 1 / -1; margin: 0; color: #f2cf68; font-size: 12px; }
+.recording-row button, .recording-row a { min-height: 44px; display: grid; place-items: center; padding: 0 14px; border: 1px solid #45647c; border-radius: 9px; color: inherit; background: #193047; font-weight: 700; text-decoration: none; }
+#playback { width: 100%; height: 100%; min-height: 0; background: #000; border-radius: 10px; }
+.empty-list { color: #9db1bf; text-align: center; padding: 40px 12px; }
+.toast { position: fixed; z-index: 9; left: 50%; bottom: 78px; transform: translateX(-50%); max-width: 80%; padding: 10px 18px; border-radius: 9px; background: #233b4e; box-shadow: 0 8px 24px #0009; }
+
+@media (max-width: 1100px) and (orientation: landscape) {
+  .competition-shell { gap: 5px; padding: 6px 8px; }
+  .status-bar { min-height: 48px; grid-template-columns: minmax(160px, 1.4fr) repeat(5, minmax(75px, 1fr)); gap: 5px; }
+  .brand, .status-item { padding: 4px 8px; }
+  .brand strong { font-size: 17px; }
+  .recording-detail { min-height: 32px; }
+  .action-bar button { min-height: 50px; }
+  .recordings-panel { inset: 58px 10px 64px; }
+}
+
+@media (orientation: portrait) {
+  .status-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .brand { grid-column: 1 / -1; }
+  .recording-detail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .recordings-panel { inset: 10px; grid-template-columns: 1fr; grid-template-rows: auto minmax(150px, 1fr) minmax(180px, 1fr); }
+}
