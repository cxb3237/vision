server {
    listen 192.168.50.1:80;
    server_name _;
    server_tokens off;
    root @PROJECT_DIR@/web_competition;
    index index.html;
    autoindex off;
    client_max_body_size 64k;

    location = /api/preview.mjpg {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 70s;
        add_header Cache-Control "no-store" always;
        add_header X-Accel-Buffering "no" always;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8000;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/api/(status|recording/start|recording/stop|recordings)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /recordings/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_force_ranges on;
        proxy_read_timeout 120s;
        add_header Cache-Control "no-store" always;
    }

    location ~* \.(css|js)$ {
        try_files $uri =404;
        expires 5m;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}

server {
    listen 192.168.50.1:8080;
    server_name _;
    server_tokens off;
    autoindex off;
    client_max_body_size 64k;

    location = /api/preview.mjpg {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 70s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /debug/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_cache off;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    location ~* \.(css|js)$ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_read_timeout 10s;
        expires 5m;
        add_header Cache-Control "public, max-age=300" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-cache" always;
    }
}
