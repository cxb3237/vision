-
-    def read(self, size: int) -> bytes:
-        time.sleep(0.002)
-        with self.lock:
-            if self.closed:
-                self.bad_fd = True
-                raise OSError("Bad file descriptor")
-            data = bytes(self.incoming.popleft() for _ in range(min(size, len(self.incoming))))
-            return data
-
-    def write(self, data: bytes) -> int:
-        with self.lock:
-            if self.closed:
-                self.bad_fd = True
-                raise OSError("Bad file descriptor")
-            self.written.append(data)
-            return len(data)
-
-    def close(self) -> None:
-        with self.lock:
-            self.closed = True
